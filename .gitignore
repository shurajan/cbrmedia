# =============================================================================
# cbrmedia — единый .gitignore для всего monorepo
#   1. Общие правила (ОС, редакторы, логи, секреты) — действуют везде
#   2. apps/ios         — Xcode / Swift
#   3. services/        — общие правила Go
# =============================================================================

# --- 1. Общие ------------------------------------------------------------------

# ОС
.DS_Store
Thumbs.db

# IDE / редакторы
.idea/
*.iml
.vscode/
*.swp
*.swo
*~

# Логи и временные файлы
*.log
*.tmp
*.temp
*.cache
*.bak

# Секреты и окружение
.env
*.env

# Служебная папка служб (CBR_HOME), если её создали внутри репозитория:
# конфиги с токенами, база, записи и медиатека
.cbr/
cbr-dev/

# --- 2. iOS (apps/ios) ----------------------------------------------------------

# Пользовательские настройки Xcode
apps/ios/**/xcuserdata/
apps/ios/**/*.xcscmblueprint
apps/ios/**/*.xccheckout

# Артефакты сборки
apps/ios/**/build/
apps/ios/**/DerivedData/
apps/ios/**/*.moved-aside
apps/ios/**/*.pbxuser
!apps/ios/**/default.pbxuser
apps/ios/**/*.mode1v3
!apps/ios/**/default.mode1v3
apps/ios/**/*.mode2v3
!apps/ios/**/default.mode2v3
apps/ios/**/*.perspectivev3
!apps/ios/**/default.perspectivev3
apps/ios/**/*.hmap

# Упаковка приложения
apps/ios/**/*.ipa
apps/ios/**/*.dSYM.zip
apps/ios/**/*.dSYM

# Playgrounds
apps/ios/**/timeline.xctimeline
apps/ios/**/playground.xcworkspace

# Swift Package Manager / Carthage / Accio
apps/ios/**/.build/
apps/ios/Carthage/Build/
apps/ios/**/Dependencies/
apps/ios/**/.accio/

# fastlane
apps/ios/fastlane/report.xml
apps/ios/fastlane/Preview.html
apps/ios/fastlane/screenshots/**/*.png
apps/ios/fastlane/test_output

# Code Injection
apps/ios/**/iOSInjectionProject/

# --- 3. Go (services/*) ---------------------------------------------------------

# Бинарники, библиотеки, тесты
services/**/*.exe
services/**/*.exe~
services/**/*.dll
services/**/*.so
services/**/*.dylib
services/**/*.test
services/**/*.out

# Локальные базы данных (SQLite в режиме WAL держит рядом -wal и -shm) и блокировки
services/**/*.db
services/**/*.db-wal
services/**/*.db-shm
services/**/*.lock

# Бинарники служб: make build, dev.sh и deploy/install.sh кладут их в bin/ или в
# $CBR_HOME/bin, а простой `go build` — в корень модуля или в cmd/<служба>/.
# Новую службу добавить сюда же.
services/recorder/recorder
services/recorder/cmd/recorder/recorder
services/recorder/hlsprobe
services/recorder/cmd/hlsprobe/hlsprobe
# Результаты hlsprobe: ответы status API и CDN, сегменты и ключи стримов
hlsprobe-*/
# Записи стримов, положенные в корень репо для разбора
/recordings/
services/tbot/tbot
services/tbot/cmd/tbot/tbot
services/api/api
services/api/cmd/api/api
services/converter/converter
services/converter/cmd/converter/converter

# Сборка и зависимости
services/**/bin/
services/**/build/
services/**/dist/
services/**/vendor/
services/**/go.work
services/**/go.work.sum

# Секреты: конфиги служб живут вне репозитория, в $CBR_HOME/config/.
# Шаблоны services/<служба>/config.example.json под эти правила не попадают.
services/**/config.json
services/**/recorder.json
services/**/tbot.json
services/**/api.json
services/**/auth.json
services/**/secret.json
services/**/.token
